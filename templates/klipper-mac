#!/bin/bash
# klipper-mac start|stop|restart|status|open|log  (generated by klipper-macos)
DATA="@DATA@"
LABEL="@LABEL@"
MOONRAKER="http://127.0.0.1:@MOONRAKER_PORT@"
MAINSAIL="http://127.0.0.1:@MAINSAIL_PORT@"
AGENTS="$HOME/Library/LaunchAgents"
SERVICES="klipper moonraker mainsail helper"

case "$1" in
  start)
    for s in $SERVICES; do launchctl bootstrap "gui/$UID" "$AGENTS/$LABEL.$s.plist" 2>/dev/null; done
    sleep 4; "$0" status ;;
  stop)
    for s in $SERVICES; do launchctl bootout "gui/$UID/$LABEL.$s" 2>/dev/null; done
    echo "Klipper stopped: the USB port is free again" ;;
  restart)
    launchctl kickstart -k "gui/$UID/$LABEL.klipper" && echo "Klipper restarted" ;;
  status)
    for s in $SERVICES; do
      if launchctl print "gui/$UID/$LABEL.$s" >/dev/null 2>&1; then echo "● $s"; else echo "○ $s"; fi
    done
    curl -s -m 3 "$MOONRAKER/printer/objects/query?print_stats&extruder&heater_bed&webhooks" | python3 -c '
import json, sys
s = json.load(sys.stdin)["result"]["status"]
w = s["webhooks"]
if w["state"] != "ready":
    print("klipper:", w["state"], "-", w.get("state_message", "").splitlines()[0])
    sys.exit()
job = s.get("print_stats", {})
print("klipper: ready |", job.get("state", "?"), job.get("filename") or "")
for h in ("extruder", "heater_bed"):
    if s.get(h):
        print("%-10s %.1f / %.0f °C" % (h, s[h]["temperature"], s[h]["target"]))' 2>/dev/null \
      || echo "moonraker not answering (still starting? try again in a few seconds)" ;;
  open)
    open "$MAINSAIL" ;;
  log)
    tail -n "${2:-40}" "$DATA/logs/klippy.log" ;;
  *)
    echo "usage: klipper-mac start | stop | restart | status | open | log [lines]" ;;
esac
